[
{
"id": "c00",
"text": "Long ago, in a forest school, Guru Drona taught the young princes.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c01",
"text": "One morning, he set them a test.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c02",
"text": "High on a tree, he placed a small wooden bird.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c03",
"text": "Aim for its eye, he said.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c04",
"text": "But first, tell me\u2026 what do you see?",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c05",
"text": "The eldest prince raised his bow.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c06",
"text": "I see the tree, the branches, the leaves\u2026 and my brothers.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c07",
"text": "Step aside.",
"voice": "bm_george",
"speed": 0.85
},
{
"id": "c08",
"text": "The next saw the sky, the bird, and his teacher.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c09",
"text": "Step aside.",
"voice": "bm_george",
"speed": 0.85
},
{
"id": "c10",
"text": "One by one, they all stepped aside.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c11",
"text": "Then came Arjuna.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c12",
"text": "What do you see?",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c13",
"text": "I see only the bird.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c14",
"text": "Look closer.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c15",
"text": "Only its eye.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c16",
"text": "Then shoot.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c17",
"text": "The arrow found its mark.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c18",
"text": "Arjuna became the greatest archer of his age.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c19",
"text": "The world will always show you a hundred things.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c20",
"text": "See only your goal,",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c21",
"text": "and you will hit it.",
"voice": "bm_george",
"speed": 0.9
},
{
"id": "c22",
"text": "Follow for more stories.",
"voice": "bm_george",
"speed": 0.9
}
]