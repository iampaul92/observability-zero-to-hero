[
{
"id": "c00",
"text": "बहुत समय पहले, कैलाश पर्वत पर,",
"voice": "hm_omega",
"lang": "hi",
"speed": 1.013
},
{
"id": "c01",
"text": "स्वर्ग से एक सुनहरा फल गिरा।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c02",
"text": "संपूर्ण ज्ञान का फल।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c03",
"text": "पर वह फल एक ही था।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c04",
"text": "और शिव जी के दो पुत्र थे।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c05",
"text": "फुर्तीले कार्तिकेय,",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c06",
"text": "और बुद्धिमान गणेश।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c07",
"text": "जो पूरे संसार की",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c08",
"text": "तीन परिक्रमा पहले करेगा,",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.987
},
{
"id": "c09",
"text": "फल उसी का होगा।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c10",
"text": "कार्तिकेय अपने मोर पर सवार हुए",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c11",
"text": "और पलक झपकते ही उड़ गए।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c12",
"text": "गणेश ने अपने नन्हे मूषक को देखा।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c13",
"text": "और मुस्कुराए।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c14",
"text": "सागर के पार।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c15",
"text": "पर्वतों के पार।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c16",
"text": "हर देश के पार।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c17",
"text": "गणेश ने बस अपने माता-पिता की परिक्रमा की।",
"voice": "hm_omega",
"lang": "hi",
"speed": 1.036
},
{
"id": "c18",
"text": "एक बार।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c19",
"text": "दो बार।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c20",
"text": "तीन बार।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c21",
"text": "आप ही मेरा पूरा संसार हैं।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c22",
"text": "और फल गणेश का हुआ।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c23",
"text": "जब कार्तिकेय लौटे, तब तक दौड़ जीती जा चुकी थी।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c24",
"text": "इसीलिए कहते हैं,",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c25",
"text": "संसार बाहर नहीं है।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c26",
"text": "संसार वे हैं, जिन्होंने हमें बनाया।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
},
{
"id": "c27",
"text": "ऐसी और कहानियों के लिए फ़ॉलो करें।",
"voice": "hm_omega",
"lang": "hi",
"speed": 0.95
}
]